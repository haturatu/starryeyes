# Host paths bind-mounted into the Compose service. Both must exist and be
# writable by UID 10001. DATA_DIR_HOST defaults to /var/lib/starryeyes if
# omitted. OUTPUT_DIR_HOST is required and used only for bind-mount expansion.
DATA_DIR_HOST=/var/lib/starryeyes
OUTPUT_DIR_HOST=/mnt/remote-output/starryeyes

# Optional overrides; Compose uses the shown values when these are omitted.
# Public host port (default: 8080).
HOST_PORT=8080

# Service limits passed into the container (shown defaults).
SPOOL_CAPACITY_BYTES=21474836480
CHUNK_SIZE_BYTES=67108864
MAX_ACTIVE_TRANSCODES=2
MAX_WIDTH=7680
MAX_HEIGHT=4320
MAX_STREAMS=64
MAX_DURATION_SECONDS=86400
# Expire PENDING/ADMITTED/UPLOADING jobs after this much inactivity.
UPLOAD_RETENTION=168h

# Video encoder auto mode uses this render node when it is exposed with
# compose.vaapi.yaml. RENDER_GID is required only by that optional override.
VAAPI_DEVICE=/dev/dri/renderD128
RENDER_GID=

# Compose has no delegated cgroup, so keep this disabled unless the deployment
# is changed to provide one.
CGROUP_ROOT=
REQUIRE_CGROUP=false
REQUIRE_LANDLOCK=true

# Structured service logging. Use LOG_FORMAT=text and LOG_LEVEL=debug locally.
LOG_LEVEL=info
LOG_FORMAT=json
